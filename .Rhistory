labs(
y = "Body mass in grams",
x = "Species"
)
p5 <- ggplot(penguins, aes(x = flipper_length_mm, y = body_mass_g)) +
geom_point(color = "steelblue") +
labs(
y = NULL,
x = "Flipper length in mm"
)
p6 <- ggplot(penguins, aes(x = bill_length_mm, y = body_mass_g)) +
geom_point(color = "steelblue") +
labs(
y = NULL,
x = "Bill length in mm"
)
p4 + p5 / p6
