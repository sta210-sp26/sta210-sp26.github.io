p2 <- ggplot(penguins,
aes(x = flipper_length_mm, y = body_mass_g,
color = species)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE) +
labs(x = "Bill length in millimeters", y = NULL, color = NULL) +
theme(legend.position = c(0.3, 0.9)) +
scale_color_OkabeIto()
