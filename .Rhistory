geom_vline(xintercept = slope, color = "#8F2D56", size = 1) +
labs(x = "Slope", y = "Count",
title = "Bootstrap sampling distribution",
subtitle = "1000 bootstrap samples") +
scale_x_continuous(labels = label_dollar())
