library(tidyverse)
library(tidymodels)
library(knitr)
#| echo: true
penguins <- palmerpenguins::penguins |>
select(body_mass_g, flipper_length_mm, bill_length_mm, species) |>
drop_na()
#| label: main-effects-model
penguins_fit <- lm(body_mass_g ~ flipper_length_mm +
species + bill_length_mm,
data = penguins)
tidy(penguins_fit) |>
kable(digits = 3)
n = 100
set.seed(210)
null_dist <- penguins |>
specify(body_mass_g ~ flipper_length_mm +
species + bill_length_mm) |>
hypothesize(null = "independence") |>
generate(reps = n, type = "permute") |>
fit()
view(null_dist)
bill_null <- null_dist |> filter(term == "bill_length_mm")
view(bill_null)
hist(bill_null$estimate)
hist(bill_null$estimate)
summary(bill_null$estimate)
sd(bill_null$estimate)
