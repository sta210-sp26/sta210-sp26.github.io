#| include: false
library(tidyverse)
library(tidymodels)
library(knitr)
derby <- read_csv("derby.csv") |>
mutate(years_since_1896 = year - 1896)
derby_fit <- lm(speed ~ years_since_1896 + condition + starts,
data = derby)
derby_fit <- lm(speed ~ years_since_1896 + condition + starters,
data = derby)
tidy(derby_fit, conf.int = TRUE) |>
kable(digits = 3)
derby_fit_int <- lm(speed ~ years_since_1896 + condition + starters +
starters * condition,
data = derby)
tidy(derby_fit_int, conf.int = TRUE) |>
kable(digits = 3)
#| include: false
library(tidyverse)
library(tidymodels)
library(knitr)
library(patchwork)
derby <- read_csv("derby.csv") |>
mutate(years_since_1896 = year - 1896)
p1 <- ggplot(data = derby, aes(x = speed)) +
geom_histogram()
p2 <- ggplot(data = derby, aes(x = condition)) +
geom_bar()
p3 <- ggplot(data = derby, aes(x = starters)) +
geom_histogram
p1 <- ggplot(data = derby, aes(x = speed)) +
geom_histogram()
p2 <- ggplot(data = derby, aes(x = condition)) +
geom_bar()
p3 <- ggplot(data = derby, aes(x = starters)) +
geom_histogram()
p1 / (p2 + p3)
