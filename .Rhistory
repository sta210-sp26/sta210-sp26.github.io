geom_histogram(fill = "steelblue", color = "black") +
labs(title = "",
x = "Flipper length in mm")
p3 <- ggplot(penguins, aes(x = bill_length_mm)) +
geom_histogram(fill = "steelblue", color = "black") +
labs(title = "",
x = "Bill length in mm")
p1 + p2 / p3
